# CiO pilot — install as the `cio` user with `crontab -e`. Server clock: Africa/Kampala.
# Every job loads /etc/cio/cio.env, so it uses the same database as the app (CIO_DB):
# on a demo server the jobs update the demo database, on the live server the live one.
REPO=/srv/cio-construction-costs
PY=/srv/cio-construction-costs/.venv/bin/python
ENV=set -a; . /etc/cio/cio.env; set +a
# Daily 06:30: harvest UBOS/KNBS/Stats SA, settle published contracts, refit on a new release, open next ones.
30 6 * * *  cd $REPO && eval "$ENV" && $PY src/market/cycle.py daily  >> data/live/cron.log 2>&1
# Monday 05:00: refresh oil, exchange rates and rainfall; write the 18 notes and forecast pages.
0 5 * * 1   cd $REPO && eval "$ENV" && $PY src/market/cycle.py weekly >> data/live/cron.log 2>&1
# Every 3 hours (at :15): latest oil and exchange rates -> all 18 forecasts -> site pages (takes seconds).
15 */3 * * * cd $REPO && eval "$ENV" && $PY src/market/cycle.py refresh >> data/live/cron.log 2>&1
# Nightly 02:00: database backup.
0 7 1 * *   cd $REPO && eval "$ENV" && $PY src/market/cycle.py monthly >> data/live/cron.log 2>&1
0 2 * * *   cd $REPO && eval "$ENV" && deploy/backup.sh >> data/live/cron.log 2>&1
