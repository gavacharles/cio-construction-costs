# Copy to /etc/cio/cio.env (chmod 600, owned by root) and fill in.
CIO_ADMIN_KEY=replace-with-a-long-random-password
CIO_DB=/srv/cio-construction-costs/data/live/exchange.sqlite
CIO_SECURE_COOKIES=1
# For a demo instance, point at the seeded demo database and show the banner:
# CIO_DB=/srv/cio-construction-costs/data/live/demo.sqlite
# CIO_DEMO=1

# Price alerts (optional). WhatsApp Cloud API: see src/market/send_alerts.py for the template.
# CIO_SITE_URL=https://pilot.yourdomain.com
# CIO_WA_TOKEN=...            # permanent system-user token from Meta Business Manager
# CIO_WA_PHONE_ID=...         # WhatsApp business phone number ID
# CIO_WA_TEMPLATE=cio_price_alert
# CIO_WA_API_VERSION=v21.0
# Email via any SMTP service:
# CIO_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# CIO_SMTP_PORT=587
# CIO_SMTP_USER=...
# CIO_SMTP_PASS=...
# CIO_SMTP_FROM=alerts@yourdomain.com
